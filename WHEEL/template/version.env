WHEEL_PACKAGE_BASE_URL="https://github.com/RIKEN-RCCS/OPEN-WHEEL/releases/download"
#WHEEL_SIFDIR=${HOME}/ondemand/dev/SIF #for sandbox
WHEEL_SIFDIR=/home/apps/singularity/ondemand/
declare -A -p APP_VERSIONS &>/dev/null || declare -A APP_VERSIONS

# APP_VERSIONS["version"]="containerURL sifFilePath"
APP_VERSIONS["latest-2026"]="${WHEEL_PACKAGE_BASE_URL}/2026-0827-122045-release/wheel.sif ${WHEEL_SIFDIR}/wheel_2026-0827-122045-release.sif"
APP_VERSIONS["2025"]="${WHEEL_PACKAGE_BASE_URL}/2026-0827-132947-maintenance/wheel.sif ${WHEEL_SIFDIR}/wheel_2026-0827-132947-maintenance.sif"
APP_VERSIONS["2023"]="${WHEEL_PACKAGE_BASE_URL}/maintenance2023/wheel.sif ${WHEEL_SIFDIR}/maintenance2023_wheel.sif"
