# This script (`before.sh.erb`) is sourced directly into the main Bash script
# that is run when the batch job starts up. It is called before the `script.sh`
# is forked off into a separate process.
#
# There are some helpful Bash functions that are made available to this script
# that encapsulate commonly used routines when initializing a web server:
#
#   - find_port
#       Find available port in range [$1..$2]
#       Default: 2000 65535
#
# We **MUST** supply the following environment variables in this
# `before.sh.erb` script so that a user can connect back to the web server when
# it is running (case-sensitive variable names):
#
#   - $host (already defined earlier, so no need to define again)
#       The host that the web server is listening on
#
#   - $port
#       The port that the web server is listening on
#

# Export the module function if it exists
[[ $(type -t module) == "function" ]] && export -f module

# Find available port to run server on
port=$(find_port)

######################
# When /home directory is nfs-mounted with lookupcache=none option,
# the error "/usr/bin/env: bad interpreter: Text file busy" occurs.
# This is because that the script.sh is not finished being copied in a compute node.
# To prevent that, change to a file with a different name in the compute node.
######################
cp script.sh tmp.sh
mv tmp.sh script.sh
ls -al ./*

# create ${HOME}/.wheel to store static file (viewer component and download file functionality)
mkdir -p ${HOME}/.wheel 2>/dev/null

# create ${HOME}/.wheel/db to hold the SQLite databases (session.db / user.db).
# WHEEL (connect-sqlite3 / sqlite.open) does not create this directory itself, and the
# in-container default path is not reliably writable, so it must exist before launch.
mkdir -p ${HOME}/.wheel/db 2>/dev/null

# Protect WHEEL with anonymous login.
# WHEEL listens on a shared prepost node and is reachable via the OnDemand node proxy, so a
# per-instance password is required (same as the Jupyter app). The password is generated by
# OnDemand's create_passwd, stored in connection.yml, and sent by the "Connect to WHEEL" form
# (view.html.erb) to WHEEL's login page. WHEEL's entrypoint.sh creates the "anonymous" user
# with it. Only containers which take the password value itself in WHEEL_ANONYMOUS_PASSWORD
# are listed here (2025 takes a file path, 2023 has no login feature).
case "<%= context.wheel_version %>" in
  latest-2026)
    password="$(create_passwd 16)"
    export WHEEL_ANONYMOUS_LOGIN="YES"
    export WHEEL_ANONYMOUS_PASSWORD="${password}"
    wheel_login="yes"
    # user/session DBs per instance: entrypoint.sh clears the user DB at every start,
    # so a shared DB would invalidate the password of another running instance
    WHEEL_DB_DIR="${PWD}/wheel_db"
    mkdir -p -m 700 "${WHEEL_DB_DIR}"
    export WHEEL_DB_DIR
    ;;
  *)
    wheel_login="no"
    ;;
esac

if [ "<%= context.key_mode %>" == "Single-use key pair" ];then
  export WHEEL_GENERATE_KEYPAIR="YES"
fi

# Put ssh ControlMaster sockets under the container-private /tmp (see --no-mount tmp in script.sh).
# The default (~/.ssh) is on a network file system where socket creation can fail, and its
# path can exceed the unix domain socket path length limit.
export SSH_CONTROL_PERSIST_DIR=/tmp
