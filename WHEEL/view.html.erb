<%- if defined?(wheel_login) && wheel_login == "yes" -%>
<form action="/node/<%= host %>/<%= port %>/login" method="post" target="_blank">
  <input type="hidden" name="username" value="anonymous">
  <input type="hidden" name="password" value="<%= password %>">
  <button class="btn btn-primary" type="submit">
    <i class="fa fa-eye"></i> Connect to WHEEL
  </button>
</form>
<%- else -%>
<a href="/node/<%= host %>/<%= port %>/" class="btn btn-primary" target="_blank" rel="noopener noreferrer">
    <i class="fa fa-eye"></i> Connect to WHEEL
</a>
<%- end -%>
